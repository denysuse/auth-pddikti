# Salin ke .env lalu sesuaikan. Semua variabel opsional.

# Alamat bind layanan. Bawaan fork ini 127.0.0.1 (hanya lokal);
# isi 0.0.0.0 hanya bila memang perlu diakses dari jaringan, idealnya
# di belakang reverse proxy + API_KEY.
HOST=127.0.0.1

# Port HTTP layanan
PORT=8090

# Jika diisi, semua endpoint /api/* wajib menyertakan header X-API-Key
API_KEY=

# Daftar origin CORS yang diizinkan, dipisah koma. Kosong = semua origin (*)
CORS_ORIGINS=

# Batas request /api/* per IP klien per menit. 0 = nonaktif
RATE_LIMIT_PER_MINUTE=30

# Panjang minimal parameter q pada /api/search
SEARCH_MIN_QUERY_LEN=3

# Endpoint /api/search nonaktif secara bawaan di fork ini.
# Isi 1 hanya bila memang perlu pencarian kata kunci bebas.
ENABLE_SEARCH=

# IP/CIDR reverse proxy yang dipercaya untuk X-Forwarded-For, dipisah koma.
# Kosong = tidak percaya proxy mana pun (pakai IP koneksi langsung)
TRUSTED_PROXIES=

# Hanya untuk test live (go test -tags=live). Jangan commit data asli.
PDDIKTI_TEST_NIM=
PDDIKTI_TEST_KAMPUS=
